ZONE=$MY_DOMAIN # ⚠️ ensure this equals the registered domain without an added subdomain, e.g. mydomain.tld
SUBDOMAIN="*" # ⚠️ If you want to use a subdomain, e.g. test.mydomain.tld, set this variable to '*.test'. Ensure that the '*' is still present!
CLOUDFLARE_API_KEY=CHANGE_ME # ⚠️
ENABLE_PROXY=false